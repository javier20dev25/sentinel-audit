{
  "_comment": "Sentinel Cloud worker engine is loaded directly from its local production source. No hosted scan API is used.",
  "sentinelCloud": {
    "repo": "%USERPROFILE%\\sentinel-cloud",
    "worker": "%USERPROFILE%\\sentinel-cloud\\packages\\worker\\index.js",
    "bridge": "%USERPROFILE%\\sentinel-cloud\\packages\\worker\\scan-bridge.cjs",
    "engine": "%USERPROFILE%\\sentinel-cloud\\packages\\worker\\core\\scanner\\index.js",
    "astInspector": "%USERPROFILE%\\sentinel-cloud\\packages\\worker\\core\\scanner\\ast_inspector.js",
    "config": "%USERPROFILE%\\sentinel-cloud\\packages\\worker\\core\\scanner\\config.js"
  },
  "codeql": {
    "bin": "%LOCALAPPDATA%\\opencode\\tools\\codeql\\codeql.exe",
    "ramDefault": 4096,
    "ramMonorepo": 8192,
    "suites": {
      "javascript": "%USERPROFILE%\\.codeql\\packages\\codeql\\javascript-queries\\2.4.6\\codeql-suites\\javascript-security-extended.qls",
      "typescript": "%USERPROFILE%\\.codeql\\packages\\codeql\\javascript-queries\\2.4.6\\codeql-suites\\javascript-security-extended.qls",
      "python": "%USERPROFILE%\\.codeql\\packages\\codeql\\python-queries\\1.8.11\\codeql-suites\\python-security-extended.qls"
    }
  },
  "semgrep": { "bin": "semgrep", "configs": ["p/security-audit", "p/secrets"] },
  "bandit": { "bin": "%LOCALAPPDATA%\\opencode\\tools\\bandit-env\\Scripts\\bandit.exe" },
  "shellcheck": { "bin": "%LOCALAPPDATA%\\opencode\\tools\\bandit-env\\Scripts\\shellcheck.exe", "severity": "warning" },
  "trivy": { "bin": "%LOCALAPPDATA%\\opencode\\tools\\trivy.exe", "scanners": "vuln,secret,misconfig" },
  "osv": { "bin": "%LOCALAPPDATA%\\opencode\\tools\\osv-scanner.exe" }
}
