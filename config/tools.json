{
  "_comment": "Sentinel Audit configuration. Cloud intelligence is provided by Sentinel Cloud via @sentinel/cloud-client (--cloud). Specialists are discovered on PATH or via environment overrides.",
  "sentinelCloud": {
    "hosted": {
      "_comment": "Protocol and transport live in @sentinel/cloud-client. The runner never builds its own authenticated request; it resolves this module and calls it.",
      "clientModule": "@sentinel/cloud-client",
      "baseUrlEnv": "SENTINEL_CLOUD_URL",
      "tokenEnv": "SENTINEL_CLOUD_API_TOKEN"
    }
  },
  "codeql": {
    "bin": "codeql",
    "envVar": "SPECIALIST_CODEQL_PATH",
    "ramDefault": 4096,
    "ramMonorepo": 8192,
    "suites": {
      "javascript": "javascript-security-extended.qls",
      "typescript": "javascript-security-extended.qls",
      "python": "python-security-extended.qls"
    }
  },
  "semgrep": {
    "bin": "semgrep",
    "envVar": "SPECIALIST_SEMGREP_PATH",
    "configs": ["rules/semgrep"],
    "allowRemoteRules": false
  },
  "bandit": { "bin": "bandit", "envVar": "SPECIALIST_BANDIT_PATH" },
  "shellcheck": { "bin": "shellcheck", "envVar": "SPECIALIST_SHELLCHECK_PATH", "severity": "warning" },
  "trivy": { "bin": "trivy", "envVar": "SPECIALIST_TRIVY_PATH", "scanners": "vuln,secret,misconfig", "offline": false },
  "osv": { "bin": "osv-scanner", "envVar": "SPECIALIST_OSV_PATH", "offline": false }
}
