{
    "name":  "sentinel-audit",
    "version":  "1.3.1",
    "type":  "commonjs",
    "description":  "Terminal-first security audit orchestrator for pinned repository commits, analyzer coverage, raw evidence and human adjudication.",
    "bin":  {
                "sentinel-audit":  "./audit-runner.js"
            },
    "main":  "audit-runner.js",
    "files":  [
                  "adapters/",
                  "config/",
                  "correlate/",
                  "lib/",
                  "reports/",
                  "rules/",
                  "workflow/",
                  "audit-runner.js",
                  "sentinel-audit.cmd",
                  "README.md",
                  "LICENSE",
                  "SECURITY.md",
                  "CONTRIBUTING.md",
                  "CHANGELOG.md"
              ],
    "engines":  {
                    "node":  "\u003e=20.0.0"
                },
    "scripts":  {
                    "test":  "node --test \"test/**/*.test.js\"",
                    "doctor":  "node audit-runner.js doctor --json",
                    "help":  "node audit-runner.js --help"
                },
    "keywords":  [
                     "sentinel",
                     "security",
                     "audit",
                     "orchestrator",
                     "sast",
                     "codeql",
                     "semgrep"
                 ],
